{
  "name": "{{APP_NAAM}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Applicatie uit de software factory.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch app/src/main.ts",
    "chat": "tsx app/src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "tsx app/src/db/migrate.ts",
    "seed": "tsx app/src/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:pact-verify": "vitest run --config vitest.pact-verify.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "verify": "factory verify",
    "release": "factory release",
    "promote": "factory promote",
    "env": "factory env",
    "flag": "factory flag"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "factory": "{{FACTORY_DEP}}",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
