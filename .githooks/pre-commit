#!/usr/bin/env bash
# Snelle poort vóór elke commit in de factory zelf.
# De factory kan zichzelf niet als dependency hebben, dus roept hier haar
# eigen gebouwde CLI aan. Overslaan kan met: git commit --no-verify

set -euo pipefail

if ! command -v node >/dev/null 2>&1 && [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.nvm/nvm.sh"
  nvm use --silent >/dev/null 2>&1 || true
fi

cd "$(git rev-parse --show-toplevel)"
corepack pnpm run build

# dist/ staat bewust in git: applicaties halen de factory als git-dependency
# binnen, en pnpm mag daar geen buildstap draaien zonder toestemming die je per
# commit-hash zou moeten vastleggen. De build hoort dus in dezelfde commit als
# de bron waar hij bij hoort, en wordt daarom hier meegenomen.
git add dist

node dist/cli.js verify --pre-commit
